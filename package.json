{
  "name": "smart-discount",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "dotenv -e .env.dev -- shopify app dev --config shopify.app.dev.toml",
    "prod": "dotenv -e .env.prod -- shopify app dev --config shopify.app.prod.toml",
    "build-extension:dev": "shopify app build --config shopify.app.dev.toml",
    "build-extension:prod": "shopify app build --config shopify.app.prod.toml",
    "deploy:dev": "shopify app deploy --config shopify.app.dev.toml",
    "deploy:prod": "shopify app deploy --config shopify.app.prod.toml",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run start",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",

    "prisma:migrate:new": "dotenv -e .env.dev -- prisma migrate dev --create-only --name",
    "prisma:migrate:apply": "dotenv -e .env.dev -- prisma migrate deploy",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy && dotenv -e .env.prod -- prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "dotenv -e .env.dev -- prisma migrate status",
    "prisma:validate": "node --env-file=env.example.txt node_modules/prisma/build/index.js validate",
    "prisma:format": "node --env-file=env.example.txt node_modules/prisma/build/index.js format",

    "db:dev": "dotenv -e .env.dev -- npx prisma studio",
    "db:prod": "dotenv -e .env.prod -- npx prisma studio",
    "graphql-codegen": "graphql-codegen",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "isbot": "^5.1.31",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "tailwindcss": "^3.4.19",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "Vaibhav",
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}